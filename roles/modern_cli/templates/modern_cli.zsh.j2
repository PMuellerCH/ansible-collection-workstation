# Modern CLI tool aliases — managed by Ansible (modern_cli role)
{% if modern_cli_bat_enabled %}
command -v batcat  &>/dev/null && alias cat='batcat --paging=never'
{% endif %}
{% if modern_cli_btop_enabled %}
command -v btop    &>/dev/null && alias top='btop'
{% endif %}
{% if modern_cli_ripgrep_enabled %}
command -v rg      &>/dev/null && alias grep='rg'
{% endif %}
{% if modern_cli_fd_enabled %}
command -v fd      &>/dev/null && alias find='fd'
{% endif %}
{% if modern_cli_eza_enabled %}

# eza — modern ls replacement
if command -v eza &>/dev/null; then
  alias ls='eza --icons'
  alias l='eza --icons'
  alias ll='eza -l --icons'
  alias la='eza -lah --icons'
  alias lt='eza --tree --icons'
fi
{% endif %}
{% if modern_cli_zoxide_enabled %}

# zoxide — smarter cd
if command -v zoxide &>/dev/null; then
  eval "$(zoxide init zsh)"
  alias cd='z'
fi
{% endif %}
{% if modern_cli_fzf_enabled %}

# fzf — Catppuccin Mocha theme
export FZF_DEFAULT_OPTS=" \
--color=bg+:#313244,bg:#1E1E2E,spinner:#F5E0DC,hl:#F38BA8 \
--color=fg:#CDD6F4,header:#F38BA8,info:#CBA6F7,pointer:#F5E0DC \
--color=marker:#B4BEFE,fg+:#CDD6F4,prompt:#CBA6F7,hl+:#F38BA8 \
--color=selected-bg:#45475A \
--color=border:#6C7086,label:#CDD6F4"
command -v fzf &>/dev/null && eval "$(fzf --zsh)"
{% endif %}
{% if modern_cli_presenterm_enabled %}

# presenterm — wrap mmdc to use system Chrome via puppeteer config (no bundled chrome-headless-shell)
mmdc() {
  command mmdc --puppeteerConfigFile "${HOME}/.config/mermaid/puppeteer-config.json" "$@"
}
{% endif %}
{% if modern_cli_emoji_fzf_enabled %}

# emoji-fzf — requires fzf (modern_cli_fzf) and wl-copy (desktop-utils role, external dependency)
if command -v emoji-fzf &>/dev/null && command -v fzf &>/dev/null && command -v wl-copy &>/dev/null; then
  emoji() {
    emoji-fzf preview | fzf --preview "emoji-fzf get --name {1}" \
      | cut -d " " -f 1 | emoji-fzf get | tr -d '\n' | wl-copy
  }
fi
{% endif %}
