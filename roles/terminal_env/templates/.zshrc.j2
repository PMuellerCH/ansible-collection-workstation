export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(git docker ansible terraform kubectl fzf-tab zsh-autosuggestions zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

# Disable Ctrl+Z suspend — prevents accidentally backgrounding processes
stty susp undef

# Catppuccin Mocha — zsh-syntax-highlighting colors
[[ -f ~/.config/zsh/catppuccin-zsh-syntax-highlighting/themes/catppuccin_mocha-zsh-syntax-highlighting.zsh ]] && \
  source ~/.config/zsh/catppuccin-zsh-syntax-highlighting/themes/catppuccin_mocha-zsh-syntax-highlighting.zsh

# PATH
export PATH="$HOME/.local/bin:$PATH"

# Role-specific shell integration (conf.d)
# The (N) glob qualifier enables NULL_GLOB for this expression only, so
# startup doesn't abort with "no matches found" if conf.d is ever empty.
for f in ~/.config/zsh/conf.d/*.zsh(N); do [[ -f "$f" ]] && source "$f"; done

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ -f ~/.config/zsh/.p10k.zsh ]] && source ~/.config/zsh/.p10k.zsh
