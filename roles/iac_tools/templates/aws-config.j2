{% for profile in iac_tools_aws_profiles %}
{% if profile.name == 'default' %}
[default]
{% else %}
[profile {{ profile.name }}]
{% endif %}
sso_start_url = {{ profile.sso_start_url }}
{% if profile.sso_role_name is defined %}
sso_role_name = {{ profile.sso_role_name }}
{% endif %}
{% if profile.sso_account_id is defined %}
sso_account_id = {{ profile.sso_account_id }}
{% endif %}
sso_region = {{ profile.sso_region }}
{% if profile.region is defined %}
region = {{ profile.region }}
{% endif %}
output = {{ profile.output | default('json') }}
{% endfor %}
