apiVersion: v1
clusters:
{% for cluster in iac_tools_kubernetes_clusters %}
- cluster:
    certificate-authority-data: {{ cluster.certificate_authority_data }}
    server: {{ cluster.server }}
  name: arn:aws:eks:{{ cluster.region }}:{{ cluster.account_id }}:cluster/{{ cluster.cluster_name }}
{% endfor %}
contexts:
{% for cluster in iac_tools_kubernetes_clusters %}
- context:
    cluster: arn:aws:eks:{{ cluster.region }}:{{ cluster.account_id }}:cluster/{{ cluster.cluster_name }}
    user: arn:aws:eks:{{ cluster.region }}:{{ cluster.account_id }}:cluster/{{ cluster.cluster_name }}
  name: {{ cluster.context_name }}
{% endfor %}
current-context: {{ iac_tools_kubernetes_current_context if iac_tools_kubernetes_current_context != '' else (iac_tools_kubernetes_clusters[0].context_name if iac_tools_kubernetes_clusters | length > 0 else '') }}
kind: Config
preferences: {}
users:
{% for cluster in iac_tools_kubernetes_clusters %}
- name: arn:aws:eks:{{ cluster.region }}:{{ cluster.account_id }}:cluster/{{ cluster.cluster_name }}
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      args:
      - --region
      - {{ cluster.region }}
      - eks
      - get-token
      - --cluster-name
      - {{ cluster.cluster_name }}
      - --role
      - {{ cluster.role_arn }}
      command: aws
      env:
      - name: AWS_PROFILE
        value: {{ cluster.aws_profile }}
      interactiveMode: IfAvailable
      provideClusterInfo: false
{% endfor %}
