# Clipboard tooling aliases — managed by Ansible (clipboard_tools role)
{% if clipboard_tools_cliphist_enabled %}

# Clipboard history — cliphist + fzf (Wayland). Requires wl-copy (from
# clipboard_tools_wl_clipboard_enabled) and fzf (from the modern_cli role,
# not part of this role) — see README "Cross-role dependencies".
if command -v cliphist &>/dev/null && command -v fzf &>/dev/null && command -v wl-copy &>/dev/null; then
  ch() {
    cliphist list | fzf --with-nth 2 | cliphist decode | wl-copy
  }
fi
{% endif %}
{% if clipboard_tools_clipse_enabled %}

# Clipboard history TUI — clipse
if command -v clipse &>/dev/null; then
  alias clipboard='clipse'
fi
{% endif %}
