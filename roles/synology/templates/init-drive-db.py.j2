#!/usr/bin/env python3
"""Pre-seed Synology Drive Client database with server connection and sync tasks.
Session and ds_id are left empty — the app will prompt for login on first run.
Server IP is left empty — public IP uses DHCP and may change.
"""
import sqlite3
import os

db_path = os.path.expanduser("~/.SynologyDrive/data/db/sys.sqlite")

con = sqlite3.connect(db_path)
cur = con.cursor()

# Schema
cur.executescript("""
CREATE TABLE IF NOT EXISTS connection_table (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    conn_mode INTEGER DEFAULT 0,
    server_name TEXT DEFAULT '',
    server_ip TEXT DEFAULT '',
    server_port INTEGER DEFAULT 0,
    quickconn_mode TEXT DEFAULT '',
    username TEXT COLLATE NOCASE DEFAULT '',
    ds_id TEXT DEFAULT '',
    session TEXT NOT NULL DEFAULT '',
    protocol_version INTEGER DEFAULT 0,
    computer_name TEXT DEFAULT '',
    use_ssl INTEGER DEFAULT 0,
    use_proxy INTEGER DEFAULT 0,
    use_system_proxy INTEGER DEFAULT 0,
    proxy_ip TEXT DEFAULT '',
    proxy_port INTEGER DEFAULT 0,
    proxy_username TEXT DEFAULT '',
    proxy_password TEXT DEFAULT '',
    proxy_domain TEXT DEFAULT '',
    proxy_host TEXT DEFAULT '',
    use_tunnel INTEGER DEFAULT 0,
    tunnel_ip TEXT DEFAULT '',
    tunnel_port INTEGER DEFAULT 0,
    linked INTEGER DEFAULT 0,
    status INTEGER DEFAULT 0,
    error INTEGER DEFAULT 0,
    package_version INTEGER DEFAULT 0,
    major INTEGER DEFAULT 0,
    minor INTEGER DEFAULT 0,
    ssl_allow_untrust INTEGER DEFAULT 0,
    user_uid INTEGER DEFAULT 0,
    user_gid INTEGER DEFAULT 0,
    user_is_admin INTEGER DEFAULT 1,
    ssl_signature TEXT DEFAULT '',
    private_key_pem TEXT DEFAULT '',
    public_key_fingerprint TEXT DEFAULT '',
    restore_id TEXT DEFAULT '',
    enable_shared_with_me INTEGER DEFAULT 0,
    conn_type INTEGER DEFAULT 0,
    host_name TEXT DEFAULT '',
    cloud_extension_clsid TEXT DEFAULT '',
    domain_name TEXT DEFAULT '',
    is_index_home INTEGER DEFAULT 0
);

CREATE TABLE IF NOT EXISTS session_table (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    conn_id INTEGER DEFAULT 0,
    share_name TEXT COLLATE NOCASE DEFAULT '',
    remote_path TEXT DEFAULT '',
    ctime DATATIME DEFAULT (strftime('%s','now')),
    view_id INTEGER DEFAULT 0,
    node_id INTEGER DEFAULT 0,
    status INTEGER DEFAULT 0,
    error INTEGER DEFAULT 0,
    share_version INTEGER DEFAULT 0,
    sync_folder TEXT DEFAULT '',
    perm_mode INTEGER DEFAULT 0,
    is_read_only INTEGER DEFAULT 0,
    is_daemon_enable INTEGER DEFAULT 0,
    sync_direction INTEGER DEFAULT 0,
    ignore_local_remove INTEGER DEFAULT 0,
    conflict_policy TEXT DEFAULT 'compare_mtime',
    rename_conflict INTEGER DEFAULT 1,
    is_encryption INTEGER DEFAULT 0,
    is_mounted INTEGER DEFAULT 1,
    attribute_check_strength INTEGER DEFAULT 0,
    sync_temp_file INTEGER DEFAULT 0,
    use_windows_cloud_file_api INTEGER DEFAULT 0,
    is_shared_with_me INTEGER DEFAULT 0,
    session_type INTEGER DEFAULT 0,
    with_c2share INTEGER DEFAULT 0,
    c2_share_id TEXT DEFAULT '',
    c2_hash_key TEXT DEFAULT '',
    is_file_filter_enable INTEGER DEFAULT 0,
    is_selective_sync_enable INTEGER DEFAULT 0,
    is_index_home INTEGER DEFAULT 0,
    is_mac_on_demand_sync_enable INTEGER DEFAULT 0,
    custom_session_name TEXT DEFAULT '',
    file_id TEXT DEFAULT '',
    symbolic_link_path TEXT DEFAULT '',
    enable_node_locking INTEGER DEFAULT 0,
    enable_auto_node_locking INTEGER DEFAULT 0,
    with_tiering INTEGER DEFAULT 0
);

CREATE TABLE IF NOT EXISTS server_view_table (
    view_id INTEGER DEFAULT 0,
    node_id INTEGER DEFAULT 0,
    conn_id INTEGER DEFAULT 0,
    privilege INTEGER DEFAULT 0,
    name TEXT COLLATE NOCASE DEFAULT '',
    share_version INTEGER DEFAULT 0,
    share_priv_disabled INTEGER DEFAULT 0,
    is_encryption INTEGER DEFAULT 0,
    is_mount INTEGER DEFAULT 1,
    is_c2share INTEGER DEFAULT 0,
    is_disable_download INTEGER DEFAULT 0,
    is_tiering INTEGER DEFAULT 0,
    PRIMARY KEY (view_id, conn_id) ON CONFLICT REPLACE
);

CREATE TABLE IF NOT EXISTS system_table (
    key VARCHAR PRIMARY KEY ON CONFLICT IGNORE,
    value VARCHAR NOT NULL
);

CREATE TABLE IF NOT EXISTS backup_plan_table (
    task_id INTEGER DEFAULT 0,
    last_complete_time INTEGER DEFAULT 0,
    next_update_time INTEGER DEFAULT 0,
    backup_start_time TEXT DEFAULT '00:00',
    backup_end_time INTEGER DEFAULT 0,
    backup_status INTEGER DEFAULT 0,
    backup_mode INTEGER DEFAULT 0,
    backup_days TEXT DEFAULT '1111111',
    backup_times INTEGER DEFAULT 0,
    backup_period INTEGER DEFAULT 0,
    do_missing_backup INTEGER DEFAULT 0
);

CREATE TABLE IF NOT EXISTS udc_event_table (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    event_key TEXT NOT NULL,
    event_value INTEGER NOT NULL DEFAULT 0,
    event_date TEXT NOT NULL,
    UNIQUE(event_key, event_date)
);

""")

# Server connection — session and ds_id left empty, server_ip left empty (DHCP)
cur.execute("""
INSERT INTO connection_table (
    conn_mode, server_name, server_ip, server_port, username,
    use_ssl, ssl_signature, conn_type, host_name, domain_name,
    is_index_home, linked
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
""", (
    3,                          # conn_mode
    "{{ synology_drive_server }}",
    "",                         # server_ip — left empty, DHCP public IP may change
    {{ synology_drive_port }},
    "{{ synology_drive_username }}",
    1,                          # use_ssl
    "{{ synology_drive_ssl_signature }}",
    1,                          # conn_type
    "{{ synology_drive_hostname }}",
    "{{ synology_drive_server }}",
    1,                          # is_index_home
    0,                          # linked — 0 until authenticated
))

conn_id = cur.lastrowid

# Server shares (populated from first connection, pre-seeded for convenience)
cur.executemany("""
INSERT OR REPLACE INTO server_view_table
    (view_id, node_id, conn_id, privilege, name, share_version, is_mount)
VALUES (?, ?, ?, ?, ?, ?, ?)
""", [
    (2, 1, conn_id, 2, "cloud", 0, 1),
    (3, 1, conn_id, 2, "home",  0, 0),
])

# Sync task 1 — private (home share → {{ synology_drive_private_local }})
cur.execute("""
INSERT INTO session_table (
    conn_id, share_name, remote_path, sync_folder,
    view_id, node_id, perm_mode, is_daemon_enable,
    sync_direction, is_mounted, is_index_home, session_type
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
""", (
    conn_id, "home", "/Privat/",
    "{{ synology_drive_private_local }}/",
    3, 13, 2, 1, 0, 1, 1, 1,
))

# Sync task 2 — shared (cloud share → {{ synology_drive_shared_local }})
cur.execute("""
INSERT INTO session_table (
    conn_id, share_name, remote_path, sync_folder,
    view_id, node_id, perm_mode, is_daemon_enable,
    sync_direction, is_mounted, is_index_home, session_type
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
""", (
    conn_id, "cloud", "/",
    "{{ synology_drive_shared_local }}/",
    2, 1, 2, 1, 0, 1, 1, 1,
))

# System settings
system_defaults = [
    ("show_tutorial",    "0"),
    ("enable_startup",   "1"),
    ("sync_mode",        "0"),
    ("enable_desktop_notification", "1"),
    ("enable_iconoverlay", "1"),
]
cur.executemany("INSERT INTO system_table (key, value) VALUES (?, ?)", system_defaults)

con.commit()
con.close()
print("Synology Drive database initialised.")
